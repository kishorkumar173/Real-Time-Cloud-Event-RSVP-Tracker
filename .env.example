# Environment Variables for Cloud-Event-RSVP-Tracker

# Application Configuration
PROJECT_NAME="Real-Time Cloud-Based Event Planning & RSVP Tracker"
VERSION="1.0.0"
DEBUG=True

# Security & Authentication
# Generate using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY="replace-with-a-secure-random-secret-key-for-cloud-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite (Default, Zero-Config):
DATABASE_URL="sqlite:///./rsvp_tracker.db"

# Cloud PostgreSQL (AWS RDS / Supabase / Render / Neon):
# DATABASE_URL="postgresql://user:password@cloud-db-host.com:5432/rsvp_db"

# CORS Configuration (Comma-separated origins)
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:8000"

# Optional Cloud Integrations
# FIREBASE_PROJECT_ID="your-firebase-project-id"
# AWS_REGION="us-east-1"
# AWS_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:rsvp-notifications"
